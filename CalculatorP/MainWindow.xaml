<Window x:Class="CalculatorP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalculatorP"
        mc:Ignorable="d"
        Title="🌸 Pink Calc" Height="480" Width="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFF0F5">

    <Window.Resources>
        <!-- Базовый стиль кнопок с поддержкой CornerRadius -->
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для цифровых кнопок -->
        <Style x:Key="NumBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#C71585"/>
        </Style>

        <!-- Стиль для кнопок операций -->
        <Style x:Key="OpBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#FFB6C1"/>
            <Setter Property="Foreground" Value="#8B008B"/>
        </Style>

        <!-- Стиль для спец-кнопок (C, Backspace) -->
        <Style x:Key="SpecialBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#FFC0CB"/>
            <Setter Property="Foreground" Value="#B22222"/>
        </Style>

        <!-- Стиль для кнопки Равно -->
        <Style x:Key="EqualsBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#FF69B4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Дисплей калькулятора -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Margin="3,3,3,12" BorderBrush="#FFB6C1" BorderThickness="1">
            <TextBlock x:Name="txtDisplay" Text="0" Foreground="#C71585" 
                       FontSize="32" FontWeight="Bold" VerticalAlignment="Center" 
                       HorizontalAlignment="Right" Margin="15,0"/>
        </Border>

        <!-- Сетка кнопок -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Ряд 1 -->
            <Button Content="C" Style="{StaticResource SpecialBtn}" Grid.Row="0" Grid.Column="0" Click="Clear_Click"/>
            <Button Content="←" Style="{StaticResource SpecialBtn}" Grid.Row="0" Grid.Column="1" Click="Backspace_Click"/>
            <Button Content="%" Style="{StaticResource OpBtn}" Grid.Row="0" Grid.Column="2" Click="Operator_Click"/>
            <Button Content="/" Style="{StaticResource OpBtn}" Grid.Row="0" Grid.Column="3" Click="Operator_Click"/>

            <!-- Ряд 2 -->
            <Button Content="7" Style="{StaticResource NumBtn}" Grid.Row="1" Grid.Column="0" Click="Num_Click"/>
            <Button Content="8" Style="{StaticResource NumBtn}" Grid.Row="1" Grid.Column="1" Click="Num_Click"/>
            <Button Content="9" Style="{StaticResource NumBtn}" Grid.Row="1" Grid.Column="2" Click="Num_Click"/>
            <Button Content="*" Style="{StaticResource OpBtn}" Grid.Row="1" Grid.Column="3" Click="Operator_Click"/>

            <!-- Ряд 3 -->
            <Button Content="4" Style="{StaticResource NumBtn}" Grid.Row="2" Grid.Column="0" Click="Num_Click"/>
            <Button Content="5" Style="{StaticResource NumBtn}" Grid.Row="2" Grid.Column="1" Click="Num_Click"/>
            <Button Content="6" Style="{StaticResource NumBtn}" Grid.Row="2" Grid.Column="2" Click="Num_Click"/>
            <Button Content="-" Style="{StaticResource OpBtn}" Grid.Row="2" Grid.Column="3" Click="Operator_Click"/>

            <!-- Ряд 4 -->
            <Button Content="1" Style="{StaticResource NumBtn}" Grid.Row="3" Grid.Column="0" Click="Num_Click"/>
            <Button Content="2" Style="{StaticResource NumBtn}" Grid.Row="3" Grid.Column="1" Click="Num_Click"/>
            <Button Content="3" Style="{StaticResource NumBtn}" Grid.Row="3" Grid.Column="2" Click="Num_Click"/>
            <Button Content="+" Style="{StaticResource OpBtn}" Grid.Row="3" Grid.Column="3" Click="Operator_Click"/>

            <!-- Ряд 5 -->
            <Button Content="±" Style="{StaticResource NumBtn}" Grid.Row="4" Grid.Column="0" Click="PlusMinus_Click"/>
            <Button Content="0" Style="{StaticResource NumBtn}" Grid.Row="4" Grid.Column="1" Click="Num_Click"/>
            <Button Content="," Style="{StaticResource NumBtn}" Grid.Row="4" Grid.Column="2" Click="Comma_Click"/>
            <Button Content="=" Style="{StaticResource EqualsBtn}" Grid.Row="4" Grid.Column="3" Click="Equals_Click"/>
        </Grid>
    </Grid>
</Window>
